# Copy to .env.local. Only public values belong in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Server-only (never prefix with NEXT_PUBLIC_): needed for billing webhooks and admin tasks.
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET= / RAZORPAY_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID= / PAYPAL_CLIENT_SECRET= / PAYPAL_WEBHOOK_ID=
# SUPPORT_EMAIL=
# Required in production (16+ random characters). Signs the short-lived password-reset cookie.
# RECOVERY_COOKIE_SECRET=

# ── Sign-in providers ──
# Google and GitHub need no variables here: configure them in the Supabase Dashboard (see docs/auth-providers.md).
# The login page shows a button only for providers Supabase reports as enabled.

# ── Account deletion (server only) ──
# Removing the sign-in identity itself is off by default because this project can be shared with other products.
# Set both only on a project dedicated to FinTrack.
# SUPABASE_SERVICE_ROLE_KEY=
# BUDGETBUDDY_DELETE_AUTH_USER=true

# ── AI assistant (server only, off until enabled; see docs/ai-and-payments.md) ──
# AI_ENABLED=true
# GEMINI_API_KEYS=key1,key2,key3
# GROQ_API_KEYS=key1,key2,key3,key4
# AI_PROVIDER_ORDER=groq,gemini
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_REQUESTS_PER_HOUR=20
# AI_TOKENS_PER_DAY=60000
