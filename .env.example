# Copy to .env.local. Only public values belong in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Origin written into canonical tags, Open Graph URLs, robots.txt and the sitemap. Set it on the deployment that serves the
# official domain. Left unset: Production uses https://getfintrack.online, other Vercel deployments use their own address.
# SEO_CANONICAL_ORIGIN=https://getfintrack.online
# Server-only (never prefix with NEXT_PUBLIC_): needed for billing webhooks and admin tasks.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPPORT_EMAIL=
# Required in production (16+ random characters). Signs the short-lived password-reset cookie.
# RECOVERY_COOKIE_SECRET=

# ── Sign-in providers ──
# Google and GitHub need no variables here: configure them in the Supabase Dashboard (see docs/auth-providers.md).
# The login page shows a button only for providers Supabase reports as enabled.

# ── Account deletion (server only) ──
# Removing the sign-in identity itself is off by default because this project can be shared with other products.
# Set both only on a project dedicated to FinTrack.
# SUPABASE_SERVICE_ROLE_KEY=
# BUDGETBUDDY_DELETE_AUTH_USER=true

# ── AI assistant (server only, off until enabled; see docs/ai-and-payments.md) ──
# Never prefix any of these with NEXT_PUBLIC_. Leave a value empty to leave that key unused.
AI_ENABLED=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Optional last fallback: OpenRouter's free models (about 50 requests a day per account). It is only ever sent
# general questions that carry nothing about the person, because free models may log inputs.
# OPENROUTER_API_KEY_1=
# Cloudflare Workers AI (10,000 free neurons a day; no training on inputs, so personal questions are allowed).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN_1=
# Mistral free plan (requests may be used for training, so general questions only; tried first for those).
# MISTRAL_API_KEY_1=
# Optional: a comma-separated pool is read as well (GEMINI_API_KEYS=k1,k2 / GROQ_API_KEYS=k1,k2).
# AI_PROVIDER_ORDER=gemini,groq
# Ordered model names, tried in turn only when a provider reports one retired. Check with: npm run ai:models
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# AI_ASSISTANT_GEMINI_MODEL=
# Keys in one Google project / one Groq organisation share a quota. Set true only if every key is a separate one.
# AI_KEYS_INDEPENDENT_QUOTA=true
# AI_REQUESTS_PER_HOUR=20
# AI_TOKENS_PER_DAY=60000

# ── Payments (server only; sandbox only until LIVE_PAYMENTS_ALLOWED is changed in code, see docs) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plans (create once in the Razorpay dashboard or with the Plans API). With none set, Razorpay sells one-time prepaid periods instead.
RAZORPAY_PLAN_ID_ONE_MONTHLY=
RAZORPAY_PLAN_ID_ONE_YEARLY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# PayPal plans: plain ones (no trial, for returning customers) and the ones that begin with the free trial cycle (5 days).
PAYPAL_PLAN_ID_ONE_MONTHLY=
PAYPAL_PLAN_ID_ONE_YEARLY=
PAYPAL_PLAN_ID_ONE_MONTHLY_TRIAL=
PAYPAL_PLAN_ID_ONE_YEARLY_TRIAL=

# ── Diagnostics ──
# PERF_LOG=1   logs how long the signed-in context takes to load (durations only)
# CRON_SECRET=   16+ random characters; Vercel Cron sends it as a bearer token to /api/cron/billing

# ── Invoices (server only; shown on the invoice people can print or save as PDF) ──
# Real business details. Left unset, the invoice carries the product name only. Add a GSTIN only if you are registered.
# INVOICE_SELLER_NAME=
# INVOICE_SELLER_ADDRESS=Line one|Line two|City, State PIN
# INVOICE_GSTIN=
# INVOICE_SUPPORT_EMAIL=
